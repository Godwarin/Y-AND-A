function(yanda_verify_imgui source manifest)
    if(IS_SYMLINK "${source}" OR NOT IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Missing or unsafe pinned ImGui tree")
    endif()
    string(JSON file_count LENGTH "${manifest}" files)
    math(EXPR last_file "${file_count} - 1")
    set(expected_files "")
    foreach(index RANGE ${last_file})
        string(JSON relative MEMBER "${manifest}" files ${index})
        string(JSON expected GET "${manifest}" files "${relative}")
        set(input "${source}/${relative}")
        file(REAL_PATH "${input}" resolved)
        if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}" OR NOT resolved STREQUAL input)
            message(FATAL_ERROR "Missing or unsafe pinned ImGui input: ${relative}")
        endif()
        file(SHA256 "${input}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Pinned ImGui SHA-256 mismatch: ${relative}")
        endif()
        list(APPEND expected_files "${relative}")
    endforeach()
    file(GLOB_RECURSE actual_files LIST_DIRECTORIES false RELATIVE "${source}" "${source}/*")
    list(FILTER actual_files EXCLUDE REGEX "^\\.git(/|$)")
    list(SORT actual_files)
    list(SORT expected_files)
    if(NOT actual_files STREQUAL expected_files)
        message(FATAL_ERROR "Unexpected files in the pinned ImGui source tree")
    endif()
endfunction()
